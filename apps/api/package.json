{
  "name": "@guestportal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@guestportal/ai-tools": "workspace:*",
    "@guestportal/analytics": "workspace:*",
    "@guestportal/auth": "workspace:*",
    "@guestportal/config": "workspace:*",
    "@guestportal/contracts": "workspace:*",
    "@guestportal/db": "workspace:*",
    "@guestportal/observability": "workspace:*",
    "@guestportal/rag": "workspace:*",
    "@guestportal/storage": "workspace:*",
    "@guestportal/tenancy": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@guestportal/eslint-config": "workspace:*",
    "@guestportal/typescript-config": "workspace:*",
    "@types/node": "^22.15.32",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.30.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
