{
  "schemaVersion": 1,
  "environments": {
    "staging": {
      "required": [
        { "name": "DATABASE_URL", "secretRef": "STAGING_DATABASE_URL", "type": "postgres-url" },
        { "name": "REDIS_URL", "secretRef": "STAGING_REDIS_URL", "type": "redis-url" },
        {
          "name": "AUTH_COOKIE_SECRET",
          "secretRef": "STAGING_AUTH_COOKIE_SECRET",
          "type": "min-length",
          "minLength": 32
        },
        { "name": "S3_ENDPOINT", "secretRef": "STAGING_R2_ENDPOINT", "type": "url" },
        { "name": "S3_BUCKET", "secretRef": "STAGING_R2_BUCKET", "type": "non-empty" },
        {
          "name": "S3_ACCESS_KEY_ID",
          "secretRef": "STAGING_R2_ACCESS_KEY_ID",
          "type": "non-empty"
        },
        {
          "name": "S3_SECRET_ACCESS_KEY",
          "secretRef": "STAGING_R2_SECRET_ACCESS_KEY",
          "type": "non-empty"
        },
        { "name": "GEMINI_API_KEY", "secretRef": "STAGING_GEMINI_API_KEY", "type": "gemini-key" }
      ],
      "public": [
        { "name": "NODE_ENV", "value": "staging", "type": "enum", "allowed": ["staging"] },
        { "name": "APP_BASE_URL", "secretRef": "STAGING_APP_BASE_URL", "type": "https-url" },
        {
          "name": "NEXT_PUBLIC_API_URL",
          "secretRef": "STAGING_PUBLIC_API_URL",
          "type": "https-url"
        }
      ]
    },
    "production": {
      "required": [
        { "name": "DATABASE_URL", "secretRef": "PRODUCTION_DATABASE_URL", "type": "postgres-url" },
        { "name": "REDIS_URL", "secretRef": "PRODUCTION_REDIS_URL", "type": "redis-url" },
        {
          "name": "AUTH_COOKIE_SECRET",
          "secretRef": "PRODUCTION_AUTH_COOKIE_SECRET",
          "type": "min-length",
          "minLength": 32
        },
        { "name": "S3_ENDPOINT", "secretRef": "PRODUCTION_R2_ENDPOINT", "type": "url" },
        { "name": "S3_BUCKET", "secretRef": "PRODUCTION_R2_BUCKET", "type": "non-empty" },
        {
          "name": "S3_ACCESS_KEY_ID",
          "secretRef": "PRODUCTION_R2_ACCESS_KEY_ID",
          "type": "non-empty"
        },
        {
          "name": "S3_SECRET_ACCESS_KEY",
          "secretRef": "PRODUCTION_R2_SECRET_ACCESS_KEY",
          "type": "non-empty"
        },
        { "name": "GEMINI_API_KEY", "secretRef": "PRODUCTION_GEMINI_API_KEY", "type": "gemini-key" }
      ],
      "public": [
        { "name": "NODE_ENV", "value": "production", "type": "enum", "allowed": ["production"] },
        { "name": "APP_BASE_URL", "secretRef": "PRODUCTION_APP_BASE_URL", "type": "https-url" },
        {
          "name": "NEXT_PUBLIC_API_URL",
          "secretRef": "PRODUCTION_PUBLIC_API_URL",
          "type": "https-url"
        }
      ]
    }
  },
  "forbiddenLiteralValues": [
    "password",
    "changeme",
    "guestportal",
    "abcdefghijklmnopqrstuvwxyz012345",
    "test-token"
  ]
}
