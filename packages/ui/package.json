{
  "name": "@guestportal/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./primitives.css": "./src/primitives.css",
    "./guest-homepage.css": "./src/guest/guest-homepage.css",
    "./guest-chat.css": "./src/guest/guest-chat.css",
    "./guest-status.css": "./src/guest/guest-status.css",
    "./tailwind-theme": {
      "types": "./src/tailwind-theme.ts",
      "import": "./src/tailwind-theme.ts",
      "default": "./src/tailwind-theme.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "node scripts/visual-snapshots.mjs",
    "test:guest-chat-visual": "node scripts/guest-chat-visual.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@guestportal/contracts": "workspace:*"
  },
  "devDependencies": {
    "@guestportal/eslint-config": "workspace:*",
    "@guestportal/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axe-core": "^4.10.3",
    "eslint": "^9.30.1",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
