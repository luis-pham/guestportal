{
  "name": "guestportal",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:health": "node scripts/docker-health.mjs",
    "db:migrate": "pnpm --filter @guestportal/db db:migrate",
    "db:seed": "pnpm --filter @guestportal/db db:seed",
    "test:integration": "pnpm --filter @guestportal/api test:integration",
    "security:secret-scan": "node scripts/security-secret-scan.mjs",
    "test:e2e": "node scripts/run-phase01-e2e.mjs",
    "phase:run": "node scripts/phase-run.mjs",
    "phase:verify": "node scripts/phase-verify.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
