# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# Apps
GUEST_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
STAFF_WEB_URL=http://localhost:3002
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
EMBEDDING_SERVICE_URL=http://localhost:4100


# Database
DATABASE_URL=postgresql://guestportal:guestportal@localhost:5432/guestportal

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (local MinIO emulates R2/S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=guestportal
S3_SECRET_ACCESS_KEY=guestportal_secret
S3_BUCKET=guest-platform-dev
S3_FORCE_PATH_STYLE=true
ASSETS_PUBLIC_BASE_URL=http://localhost:9000/guest-platform-dev

# Auth (placeholders — configure real provider in later phases)
AUTH_PROVIDER=supabase
AUTH_URL=http://localhost:54321
AUTH_ANON_KEY=replace-me
AUTH_SERVICE_ROLE_KEY=replace-me
AUTH_COOKIE_SECRET=replace-with-32-char-minimum-secret

# Gemini (never expose API key to browsers)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-preview-native-audio-dialog

# Embedding
EMBEDDING_MODEL=embeddinggemma-300m
EMBEDDING_DIMENSIONS=768
